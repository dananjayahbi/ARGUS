{
  "manifest_version": 3,
  "name": "ARGUS QA Capture",
  "version": "0.1.1",
  "description": "Capture screenshots, environment metadata and console errors into ARGUS.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/overlay.css"],
      "js": ["content/overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ARGUS QA Capture - click to open the overlay popup"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
