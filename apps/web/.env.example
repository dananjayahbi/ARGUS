# ARGUS web application configuration.
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Required: PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@host:5432/database

# Required: shared secret sent by the extension in X-Workspace-Token.
WORKSPACE_TOKEN=replace-with-at-least-32-random-characters

# Required: HMAC-SHA256 key used to sign 30-minute canvas draft tokens.
DRAFT_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Required: server-only shared secret for the Python CDN upload endpoint.
# Never expose this to the browser; canvas uploads go through /api/uploads.
CDN_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Required: dashboard session signing key (at least 32 characters).
SESSION_SECRET=replace-with-at-least-32-random-characters

# Required: initial QA and developer dashboard accounts. Passwords are
# Argon2id-hashed into the users table on first login; never logged.
QA_EMAIL=qa@example.com
QA_PASSWORD=replace-with-a-strong-password
DEVELOPER_EMAIL=developer@example.com
DEVELOPER_PASSWORD=replace-with-a-strong-password

# Required: public origin of the Python CDN (no trailing slash).
# Local dev uses the uncommon high port 18130 (see apps/cdn/.env.example).
CDN_BASE_URL=http://127.0.0.1:18130

# Optional: Sentry error tracking. Leave empty to disable it locally and in
# tests; startup still succeeds. Use the same DSN for web and CDN per
# environment, and set a distinct SENTRY_ENVIRONMENT and release tag.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=argus-web@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0

# Local dev convention (not an env var): start Next.js on the uncommon high
# port 13130 (see docs/operations/local-testing.md).
#   npm run dev -- -p 13130 -H 127.0.0.1
#   npm run start -- -p 13130 -H 127.0.0.1
# Production / Mini PC / Vercel keep the standard ports behind Cloudflare.

