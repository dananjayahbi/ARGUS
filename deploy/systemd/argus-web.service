[Unit]
Description=ARGUS web application
Documentation=file:///opt/argus/docs/operations/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argus
Group=argus
WorkingDirectory=/opt/argus/apps/web
# Contains DATABASE_URL, tokens, SESSION_SECRET and SENTRY_*. Mode 600.
EnvironmentFile=/etc/argus/web.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/argus/apps/web/.next
ReadWritePaths=/opt/argus/apps/web/.next/cache
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
