# Copy to /etc/argus/backup.env on the Mini PC.
# chown root:root, chmod 600. Never commit the real file.
#
# BACKUP_DIR must be an off-box mount (NFS, SSHFS, rclone mount, or a USB disk
# that is not the same physical device as the database and CDN storage). The
# backup script refuses to run if the variables below are missing, but the
# operator is responsible for verifying the mount is off-box.
DATABASE_URL=postgresql://argus:password@127.0.0.1:5432/qa-db
CDN_STORAGE_ROOT=/opt/argus/apps/cdn/storage
BACKUP_DIR=/mnt/offbox/argus-backups
BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BACKUP_RETENTION_DAYS=14
ALERT_WEBHOOK_URL=
