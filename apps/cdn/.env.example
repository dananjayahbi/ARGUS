# ARGUS CDN service configuration.
# Copy this file to .env and replace the token. Never commit .env.

# Required: shared secret sent by callers in the X-CDN-Auth-Token header.
CDN_AUTH_TOKEN=replace-with-at-least-32-random-characters

# Required: public origin used to build absolute asset URLs.
# Do not include a trailing slash. Example: https://cdn.example.com
CDN_BASE_URL=http://127.0.0.1:8080

# Required: filesystem root for all stored assets.
STORAGE_ROOT=./storage

# Optional: per-family upload limits in bytes (defaults shown).
MAX_IMAGE_BYTES=52428800
MAX_AUDIO_BYTES=209715200

# Optional: local bind address and log level.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# Optional: Sentry error tracking. Leave empty to disable it locally and in
# tests; startup still succeeds. Use the same DSN as the web app per
# environment.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=argus-cdn@0.1.0
SENTRY_TRACES_SAMPLE_RATE=0
